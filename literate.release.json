{
  "schema": "literate-ai/release-policy@2",
  "version_scheme": "semver",
  "version_authority": {
    "path": "literate.project.json",
    "format": "json-pointer",
    "selectors": [
      "/version"
    ]
  },
  "version_mirrors": [],
  "contributions": {
    "current_milestone": "{version}"
  },
  "allowed_transitions": [
    "patch",
    "minor",
    "major",
    "prerelease",
    "explicit"
  ],
  "gate": {
    "argv": [
      "python3",
      "verification/release_check.py"
    ],
    "timeout_seconds": 1800
  },
  "changelog": {
    "path": "CHANGELOG.md",
    "unreleased_heading": "## Unreleased"
  },
  "tag": {
    "prefix": "v",
    "signed": false
  },
  "remote": "origin",
  "provider": {
    "kind": "github",
    "repository": "NVIDIA-dev/LeRTX"
  },
  "artifact_gate": {
    "argv": [
      "python3",
      "verification/release_check.py",
      "--package-only"
    ],
    "timeout_seconds": 180,
    "manifest": "dist/release-files.json",
    "required_roles": [
      "source-setup",
      "checksums"
    ]
  },
  "documentation_authority": [
    "docs/architecture/design-traceability.md"
  ]
}
